<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral Palette -->
    <Color x:Key="ColorAppBackground">#F8FAFC</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceMuted">#F1F5F9</Color>
    <Color x:Key="ColorSidebar">#0F172A</Color>
    <Color x:Key="ColorSidebarCard">#1E293B</Color>
    <Color x:Key="ColorSidebarHover">#334155</Color>

    <Color x:Key="ColorBorder">#E2E8F0</Color>
    <Color x:Key="ColorBorderDark">#334155</Color>

    <!-- Text Palette -->
    <Color x:Key="ColorTextPrimary">#0F172A</Color>
    <Color x:Key="ColorTextSecondary">#64748B</Color>
    <Color x:Key="ColorTextMuted">#94A3B8</Color>
    <Color x:Key="ColorTextWhite">#FFFFFF</Color>

    <!-- Primary Accent -->
    <Color x:Key="ColorPrimary">#0284C7</Color>
    <Color x:Key="ColorPrimaryHover">#0369A1</Color>
    <Color x:Key="ColorPrimaryActive">#075985</Color>
    <Color x:Key="ColorPrimarySoft">#E0F2FE</Color>

    <!-- Semantic States -->
    <Color x:Key="ColorSuccess">#10B981</Color>
    <Color x:Key="ColorSuccessSoft">#D1FAE5</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>
    <Color x:Key="ColorWarningSoft">#FEF3C7</Color>
    <Color x:Key="ColorDanger">#E11D48</Color>
    <Color x:Key="ColorDangerSoft">#FFE4E6</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushAppBackground" Color="{StaticResource ColorAppBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceMuted" Color="{StaticResource ColorSurfaceMuted}" />
    <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource ColorSidebar}" />
    <SolidColorBrush x:Key="BrushSidebarCard" Color="{StaticResource ColorSidebarCard}" />
    <SolidColorBrush x:Key="BrushSidebarHover" Color="{StaticResource ColorSidebarHover}" />

    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderDark" Color="{StaticResource ColorBorderDark}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushTextWhite" Color="{StaticResource ColorTextWhite}" />

    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="BrushPrimaryActive" Color="{StaticResource ColorPrimaryActive}" />
    <SolidColorBrush x:Key="BrushPrimarySoft" Color="{StaticResource ColorPrimarySoft}" />

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushSuccessSoft" Color="{StaticResource ColorSuccessSoft}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushWarningSoft" Color="{StaticResource ColorWarningSoft}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushDangerSoft" Color="{StaticResource ColorDangerSoft}" />

</ResourceDictionary>

